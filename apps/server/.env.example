PORT=8223
NODE_ENV=development

# Local Docker Postgres 18 (root docker-compose.yml). The same URL is used for
# runtime and migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Optional override for drizzle-kit; falls back to DATABASE_URL.
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Production (RDS) verifies TLS against the RDS CA bundle baked into the image:
# DATABASE_URL=postgres://stepwhere_app:[PASSWORD]@[RDS-ENDPOINT]:5432/stepwhere?sslmode=verify-full

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8223
PUBLIC_SHARE_APP_URL=http://127.0.0.1:5175
# Optional: API base URL shown to QA bench agents when pairing (defaults to the origin of BETTER_AUTH_URL).
# QA_AGENT_SERVER_URL=https://api.stepwhere.in
# Lets GitHub Actions upload QA firmware builds to the bench (32+ random characters; also a GitHub secret).
# QA_CI_UPLOAD_TOKEN=
# Agent tarball URL shown in the pairing dialog (the dev stack sets it in public mode).
# QA_AGENT_DOWNLOAD_URL=https://example.a.pinggy.link/downloads/stepwhere-qa-agent.tgz
SHARE_LINK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Comma separated list of allowed frontend origins.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006
ADMIN_AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4800,http://127.0.0.1:4800
API_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Mobile deep-link schemes are added by the server config.
# Add any extra staging or production web origins here as needed.

AWS_REGION=ap-south-1
# Optional. Leave both unset to use the SDK default chain (the EC2 instance
# role in production); set both for local development.
AWS_ACCESS_KEY_ID=replace-with-server-only-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-server-only-secret-access-key
# App file bucket. Avatars are stored under the `avatars/` key prefix.
AWS_S3_STORAGE_BUCKET=stepwhere-storage-dev

# Optional unless enhanced push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=

DEVICE_INGEST_AUTH_DISABLED=false
DEVICE_INGEST_API_KEY=replace-with-a-shared-device-ingest-api-key
DEVICE_PROVISIONING_SECRET=replace-with-a-device-provisioning-secret
REDIS_URL=redis://:448b4a5454b91ebbe6a0203b3149eca14c501af0126e9c1f@127.0.0.1:6380/0
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROADS_API_KEY=
GOOGLE_GEOLOCATION_API_KEY=
CELL_GEOLOCATION_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional. Mobile Google email verification only needs the web client ID above.
GOOGLE_OAUTH_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DISABLE_TWILLIO_OTP=false
PREVIEW_MODE_ENABLED=false
PLAY_REVIEW_ENABLED=false
PLAY_REVIEW_PHONE_NUMBER=+919000000001
PLAY_REVIEW_OTP=000000
PLAY_REVIEW_EMAIL=play-review@stepwhere.in
PLAY_REVIEW_HARDWARE_IDENTIFIER=SW-PLAY-REVIEW-001
# Required only while running `pnpm review:provision`; keep false at runtime.
ALLOW_PLAY_REVIEW_PROVISION=false
# Required only while running the explicit reviewer push diagnostic; keep false at runtime.
ALLOW_PLAY_REVIEW_PUSH_TEST=false
TRAIL_ROAD_SNAPPING_ENABLED=false
HISTORY_ROAD_SNAPPING_ENABLED=false
REALTIME_DEBUG=false
ENABLE_API_REFERENCE=false

# Subscription backend. Keep these off until catalog, native checkout, and real
# sandbox purchase/renewal/refund verification are complete.
BILLING_PURCHASES_ENABLED=false
BILLING_EARLY_CREDIT_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
BILLING_PILOT_ORGANIZATION_IDS=
# Family ownership of physical shoes (claim on bind, 409 DEVICE_BOUND_ELSEWHERE
# for another family). On by default; independent of enforcement.
BILLING_DEVICE_OWNERSHIP_ENABLED=true
BILLING_STORE_ENVIRONMENT=SANDBOX
# Server-only organization API key: customers:read and users:read scopes.
SUPERWALL_API_KEY=
SUPERWALL_PROJECT_ID=
# Comma-separated iOS and Android Superwall application IDs.
SUPERWALL_APPLICATION_IDS=
SUPERWALL_WEBHOOK_SECRET=
# 32 random bytes encoded as 64 hex characters; stable, server-only, back up.
BILLING_OFFER_CODE_KEY=

# First-run admin setup (admin panel). The account created on first visit.
INITIAL_ADMIN_EMAIL=admin@stepwhere.in
# One-time setup code (at least 16 characters, e.g. `openssl rand -hex 16`).
# Setup is disabled while unset. Delete it once the admin exists.
ADMIN_SETUP_CODE=
