{
  "name": "@stepwhere/server",
  "portless": {
    "name": "api.stepwhere",
    "appPort": 8223
  },
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @stepwhere/types build",
    "dev": "infisical run --env=dev --projectId=c54a008b-1814-4bfe-bafa-564b6f330113 -- tsx watch src/index.ts",
    "predev:local-db": "pnpm --filter @stepwhere/types build",
    "dev:local-db": "infisical run --env=dev --projectId=c54a008b-1814-4bfe-bafa-564b6f330113 -- sh -c 'export DATABASE_URL=\"${LOCAL_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/postgres}\"; export DIRECT_URL=\"${LOCAL_DIRECT_URL:-$DATABASE_URL}\"; exec tsx watch src/index.ts'",
    "db:migrate": "infisical run --env=dev --projectId=c54a008b-1814-4bfe-bafa-564b6f330113 -- drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:local": "sh -c 'export DATABASE_URL=\"${LOCAL_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/postgres}\"; export DIRECT_URL=\"${LOCAL_DIRECT_URL:-$DATABASE_URL}\"; exec drizzle-kit migrate --config drizzle.config.ts'",
    "db:reset:dev": "infisical run --env=dev -- tsx src/scripts/reset-dev-db.ts",
    "db:reset:local": "sh -c 'export DATABASE_URL=\"${LOCAL_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5433/postgres}\"; export DIRECT_URL=\"${LOCAL_DIRECT_URL:-$DATABASE_URL}\"; exec tsx src/scripts/reset-dev-db.ts'",
    "db:seed:devices": "infisical run --env=dev -- tsx src/scripts/seed-devices.ts",
    "review:provision": "infisical run --env=dev --projectId=c54a008b-1814-4bfe-bafa-564b6f330113 -- tsx src/scripts/provision-play-review.ts",
    "review:push:test": "tsx src/scripts/test-play-review-push.ts",
    "prebuild": "pnpm --filter @stepwhere/types build",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "start": "infisical run --env=dev --projectId c54a008b-1814-4bfe-bafa-564b6f330113 -- node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @stepwhere/types build",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "echo 'db:push is disabled for this project. Use db:generate + db:migrate.' && exit 1",
    "db:rebuild:dev": "pnpm db:reset:dev && pnpm db:migrate && pnpm db:seed:devices",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@better-auth/drizzle-adapter": "^1.6.14",
    "@better-auth/expo": "^1.6.14",
    "@hono/node-server": "^2.0.2",
    "@hono/zod-openapi": "^1.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/hono-api-reference": "^0.10.20",
    "@stepwhere/types": "workspace:*",
    "@zxing/library": "^0.23.0",
    "better-auth": "^1.6.14",
    "canvas": "^3.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "expo-server-sdk": "^6.1.0",
    "google-auth-library": "^10.9.0",
    "hono": "^4.12.23",
    "ioredis": "^5.11.1",
    "jsdom": "^27.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "qr-code-styling": "^1.9.2",
    "svix": "^1.76.1",
    "qrcode-generator": "^2.0.4",
    "twilio": "^6.0.2",
    "tz-lookup": "6.1.25",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/tz-lookup": "6.1.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
