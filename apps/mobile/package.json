{
  "name": "@stepwhere/mobile",
  "main": "index.ts",
  "version": "2.0.0",
  "author": {
    "email": "aryanmishra530@gmail.com",
    "name": "v3locity47"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "typecheck": "tsc --noEmit",
    "env:pull:dev": "eas env:pull --environment development --path .env.local",
    "env:pull:prod": "eas env:pull --environment production --path .env.production.local",
    "android": "APP_VARIANT=development expo run:android --app-id com.stepwhere.dev",
    "android:dev": "APP_VARIANT=development expo run:android --app-id com.stepwhere.dev",
    "ios:dev": "expo run:ios",
    "ios:build:dev": "eas build --platform ios --profile development",
    "android:build:dev": "eas build --local --platform android --profile development",
    "eas:build:dev:android": "eas build --platform android --profile development",
    "eas:build:dev:ios": "eas build --platform ios --profile development",
    "eas:build:prod:android": "eas build --platform android --profile production",
    "eas:build:prod:ios": "eas build --platform ios --profile production",
    "eas:build:prod": "eas build --platform all --profile production",
    "eas:build:local-prod:android": "eas build --local --platform android --profile production-local --output .builds/stepwhere-production.apk",
    "eas:build:local-prod:ios": "eas build --local --platform ios --profile production-local --output .builds/stepwhere-production.ipa",
    "eas:build:local-store:android": "eas build --local --platform android --profile production --output .builds/stepwhere-production.aab",
    "eas:build:local-store:ios": "eas build --local --platform ios --profile production --output .builds/stepwhere-testflight.ipa",
    "assets:brand": "node ./scripts/generate-brand-assets.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check:worklets": "node ./scripts/check-worklets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.14",
    "@expo/dom-webview": "^56.0.5",
    "@expo/metro-runtime": "~56.0.13",
    "@expo/ui": "~56.0.15",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/fontawesome5": "^13.1.2",
    "@react-native-vector-icons/fontawesome6": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@shopify/react-native-skia": "2.6.2",
    "@stepwhere/types": "workspace:*",
    "better-auth": "^1.6.14",
    "expo": "~56.0.8",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "^56.0.4",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.16",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-network": "~56.0.4",
    "expo-notifications": "~56.0.16",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.21",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-maps": "1.27.2",
    "react-native-nitro-google-signin": "^1.0.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-unistyles": "^3.2.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "stepwhere-theme-transition": "file:./modules/stepwhere-theme-transition",
    "victory-native": "^41.26.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "pngjs": "7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.6"
  },
  "private": true
}
