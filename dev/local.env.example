# Copy to dev/local.env (gitignored). Read by scripts/dev/*. Shell variables win.

# --- Public mode (pnpm dev:public) ---------------------------------------
# Pinggy Pro persistent hosts. The panel host serves admin + API over HTTPS and
# the firmware's plain-HTTP /v1/telemetry/location, so keep it matching the
# firmware's SERVER_CMD.
STEPWHERE_PANEL_HOST=npafhgmeij.a.pinggy.link
STEPWHERE_SHARE_HOST=
# One Pinggy Pro access token per persistent host (dashboard.pinggy.io).
# The panel token is read from apps/dev-tunnel/.env.local (PINGGY_TOKEN) if you
# already set that up, in this checkout or the main one.
# PINGGY_PANEL_TOKEN=
PINGGY_SHARE_TOKEN=
# Pinggy CLI; defaults to apps/dev-tunnel/bin/pinggy, then PATH, then ssh.
# PINGGY_BIN=

# --- Secrets ----------------------------------------------------------------
# 1 (default): pull secrets from Infisical when you have access, falling back to
# local stand-ins. 0: never call Infisical.
STEPWHERE_INFISICAL=1

# Infisical machine identity, used instead of your personal `infisical login`.
# Keep these in the main checkout's root .env (gitignored on every branch and
# read by every worktree) rather than here. Either an access token:
# INFISICAL_TOKEN=
# or universal-auth credentials, exchanged for a token on each start:
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# Self-hosted Infisical only:
# INFISICAL_API_URL=

# Local Redis password (docker-compose.yml). Defaults to stepwhere-dev.
# REDIS_PASSWORD=
