# Managed by Ansible. Based on Pangolin's installer template (docs.pangolin.net).
# Users, sites and resources are created in the dashboard, not here.
gerbil:
    start_port: 51820
    base_endpoint: "{{ pangolin_dashboard_domain }}"

app:
    dashboard_url: "https://{{ pangolin_dashboard_domain }}"
    log_level: "info"
    telemetry:
        anonymous_usage: false

domains:
    domain1:
        base_domain: "{{ pangolin_base_domain }}"

server:
    secret: "{{ pangolin_server_secret }}"
    cors:
        origins: ["https://{{ pangolin_dashboard_domain }}"]
        methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
        allowed_headers: ["X-CSRF-Token", "Content-Type"]
        credentials: false

flags:
    require_email_verification: false
    disable_signup_without_invite: true
    disable_user_create_org: false
    # Raw TCP/UDP resources would need extra Traefik entrypoints and host ports.
    allow_raw_resources: false
