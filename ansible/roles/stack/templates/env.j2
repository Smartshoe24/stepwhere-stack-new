# Managed by Ansible. Non-secret settings and the secrets Compose itself needs.
# Image tags are not set here: compose.yml defaults every app image to :main and CI picks the tag.
INFISICAL_ENV={{ infisical_env }}
INFISICAL_PROJECT_ID={{ infisical_project_id }}
INFISICAL_PATH={{ infisical_path }}
REDIS_PASSWORD={{ stack_redis_password }}
BESZEL_AGENT_KEY='{{ stack_beszel_agent_key }}'
{% if stack_beszel_agent_key | length > 0 %}
COMPOSE_PROFILES=beszel-agent
{% endif %}
