# Managed by Ansible (roles/stack). One Compose project for the whole host.
# Edit the template and re-run `make host-apply`; CI only pulls images and restarts services.
name: stepwhere

services:
  # --- Pangolin edge: gerbil + traefik + pangolin, as in Pangolin's own self-host compose ---

  pangolin:
    image: {{ pangolin_image }}
    restart: unless-stopped
    networks: [edge]
    volumes:
      - {{ stack_pangolin_dir }}/config:/app/config
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001/api/v1/"]
      interval: 10s
      timeout: 10s
      retries: 15
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['pangolin'] }}

  gerbil:
    image: {{ gerbil_image }}
    restart: unless-stopped
    depends_on:
      pangolin:
        condition: service_healthy
    command:
      - --reachableAt=http://gerbil:3004
      - --generateAndSaveKeyTo=/var/config/key
      - --remoteConfig=http://pangolin:3001/api/v1/
    volumes:
      - {{ stack_pangolin_dir }}/config:/var/config
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    networks: [edge]
    # The only host ports on this machine. Traefik shares this network namespace
    # (network_mode: service:gerbil below), so its 80 and 443 are published here.
    ports:
      - "80:80"
      - "443:443"
      # Pangolin tunnels (WireGuard). Closed in the security group until a remote
      # site is needed. To enable: open both UDP ports on sg-app, then uncomment.
      # - "51820:51820/udp"
      # - "21820:21820/udp"
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['gerbil'] }}

  traefik:
    image: {{ traefik_image }}
    restart: unless-stopped
    network_mode: service:gerbil
    depends_on:
      pangolin:
        condition: service_healthy
    command:
      - --configFile=/etc/traefik/traefik_config.yml
    volumes:
      - {{ stack_pangolin_dir }}/config/traefik:/etc/traefik:ro
      - {{ stack_pangolin_dir }}/config/letsencrypt:/letsencrypt
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['traefik'] }}

  # --- Application ---

  server:
    image: {{ stack_registry }}/stepwhere-server:${SERVER_IMAGE_TAG:-main}
    restart: unless-stopped
    # The image CMD wraps `infisical run`; the token comes from this file.
    env_file:
      - {{ stack_infisical_env_file }}
    environment:
      NODE_ENV: production
      PORT: "8223"
      INFISICAL_ENV: ${INFISICAL_ENV}
      INFISICAL_PROJECT_ID: ${INFISICAL_PROJECT_ID}
      INFISICAL_PATH: ${INFISICAL_PATH:-/}
    networks: [edge, backend]
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8223/health >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 20s
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['server'] }}

  device-ingest-proxy:
    image: {{ stack_registry }}/stepwhere-device-ingest-proxy:${DEVICE_INGEST_PROXY_IMAGE_TAG:-main}
    restart: unless-stopped
    networks: [edge]
    depends_on:
      server:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:8290/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 10s
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['device-ingest-proxy'] }}

  admin:
    image: {{ stack_registry }}/stepwhere-admin:${ADMIN_IMAGE_TAG:-main}
    restart: unless-stopped
    networks: [edge]
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['admin'] }}

  share-view:
    image: {{ stack_registry }}/stepwhere-share-view:${SHARE_VIEW_IMAGE_TAG:-main}
    restart: unless-stopped
    networks: [edge]
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/health >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 10s
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['share-view'] }}

  redis:
    image: {{ redis_image }}
    restart: unless-stopped
    networks: [backend]
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD}
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --requirepass
      - "${REDIS_PASSWORD}"
    volumes:
      - {{ stack_redis_dir }}:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD}\" ping | grep PONG"]
      interval: 10s
      timeout: 3s
      retries: 10
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['redis'] }}

  # --- Monitoring (roles/monitoring prepares the directories) ---

  beszel-hub:
    image: {{ beszel_hub_image }}
    restart: unless-stopped
    networks: [edge]
    environment:
      APP_URL: https://{{ domain_monitor }}
    volumes:
      - {{ stack_beszel_dir }}/data:/beszel_data
      # The agent listens on a unix socket here: no TCP port between hub and agent.
      - {{ stack_beszel_dir }}/socket:/beszel_socket
    healthcheck:
      test: ["CMD", "/beszel", "health", "--url", "http://localhost:8090"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['beszel-hub'] }}

  # Only started once vault_beszel_agent_key is set (the key comes from the hub UI).
  # In the hub, add a system with host /beszel_socket/beszel.sock.
  beszel-agent:
    image: {{ beszel_agent_image }}
    restart: unless-stopped
    profiles: [beszel-agent]
    network_mode: host
    environment:
      LISTEN: /beszel_socket/beszel.sock
      KEY: ${BESZEL_AGENT_KEY}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ stack_beszel_dir }}/agent:/var/lib/beszel-agent
      - {{ stack_beszel_dir }}/socket:/beszel_socket
      # Disk usage of the data volume (/srv) next to the root disk.
      - /srv/.beszel:/extra-filesystems/stepwhere-data:ro
    healthcheck:
      test: ["CMD", "/agent", "health"]
      interval: 30s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['beszel-agent'] }}

  dozzle:
    image: {{ dozzle_image }}
    restart: unless-stopped
    networks: [edge]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    healthcheck:
      test: ["CMD", "/dozzle", "healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: {{ stack_mem_limits['dozzle'] }}

networks:
  # Traefik <-> every routed service.
  edge:
    name: edge
  # server <-> redis only; no route out.
  backend:
    name: backend
    internal: true
